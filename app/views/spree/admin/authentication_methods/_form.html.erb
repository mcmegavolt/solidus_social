<div data-hook="admin_social_methods_form_fields" class="row">
  <div class="col-4">
    <div data-hook="environment" class="field">
      <%= f.field_container :environment do %>
        <%= label_tag nil, Spree::AuthenticationMethod.human_attribute_name(:environment) %>
        <%= collection_select(:authentication_method, :environment, Rails.configuration.database_configuration.keys, :to_s, :titleize, {}, { class: 'select2 fullwidth' }) %>
      <% end %>
    </div>
  </div>
  <div class="col-4">
    <div data-hook="environment" class="field">
      <%= f.field_container :provider do %>
        <%= f.label :provider, I18n.t('spree.social_provider') %>
        <%= f.select :provider, Spree::AuthenticationMethod.provider_options, {}, { include_blank: false, class: 'select2 fullwidth' } %>
      <% end %>
    </div>
  </div>
  <div class="col-4">
    <div data-hook="environment" class="field">
      <%= f.field_container :active do %>
        <%= f.label :active, I18n.t('spree.active') %><br>
        <%= f.radio_button :active, :true %><span style="padding:0 2px;"><%= I18n.t('spree.say_yes') %></span>
        <%= f.radio_button :active, :false %><span style="padding:0 2px"><%= I18n.t('spree.say_no') %></span>
      <% end %>
    </div>
  </div>

  <% provider_value = f.object.provider.presence || (params[:authentication_method] && params[:authentication_method][:provider]) %>
  <% env_credentials = Spree::AuthenticationMethod.environment_credentials_for(provider_value) %>
  <% env_managed = env_credentials[:api_key].present? || env_credentials[:api_secret].present? %>

  <% if env_managed %>
    <div class="col-12">
      <div class="alert alert-info">
        <%= I18n.t('spree.social_env_credentials_notice') %>
      </div>
    </div>
  <% end %>

  <div class="col-6">
    <div data-hook="api-key" class="field">
      <%= f.field_container :api_key do %>
        <%= f.label :api_key, I18n.t('spree.social_api_key') %>
        <%= f.text_field :api_key, class: 'fullwidth', disabled: env_managed, placeholder: env_managed ? I18n.t('spree.social_env_placeholder') : nil %>
      <% end %>
    </div>
  </div>
  <div class="col-6">
    <div data-hook="api-secret" class="field">
      <%= f.field_container :api_secret do %>
        <%= f.label :api_secret, I18n.t('spree.social_api_secret') %>
        <%= f.text_field :api_secret, class: 'fullwidth', disabled: env_managed, placeholder: env_managed ? I18n.t('spree.social_env_placeholder') : nil %>
      <% end %>
    </div>
  
  <% unless env_managed || env_credentials[:api_key].present? || env_credentials[:api_secret].present? || f.object.api_key.present? || f.object.api_secret.present? %>
    <div class="col-12">
      <p class="text-muted"><%= I18n.t('spree.social_missing_credentials_notice') %></p>
    </div>
  <% end %>
</div>
</div>
